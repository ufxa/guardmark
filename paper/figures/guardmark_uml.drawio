        <mxCell id="sep_in" value="three-layer injection" style="text;html=1;strokeColor=none;fillColor=none;align=right;fontSize=7;fontStyle=2;fontColor=#888888;" vertex="1" parent="1">
          <mxGeometry x="271" y="130" width="160" height="14" as="geometry" />
        </mxCell>

        <!-- Layer 1: WIA -->
        <mxCell id="l1" value="&lt;b&gt;L1 · WIA — Statistical Token Watermarking&lt;/b&gt;&lt;br&gt;Key schedule: 𝒢_t ← h(𝒦 ‖ t)  ;  Logit bias: ℓ_t[w] += δ  ∀ w ∈ 𝒢_t&lt;br&gt;FineTune(ℳ, 𝒟, {ℓ_t + δ·𝟏[· ∈ 𝒢_t]})" style="rounded=2;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#111111;strokeWidth=1.2;fontSize=7.5;align=center;" vertex="1" parent="1">
          <mxGeometry x="28" y="146" width="404" height="52" as="geometry" />
        </mxCell>

        <!-- Layer 2: FVA -->
        <mxCell id="l2" value="&lt;b&gt;L2 · FVA — Behavioral Fingerprinting&lt;/b&gt;&lt;br&gt;Embed trigger-response pairs ℱ = {(p_i, r_i)} via LoRA adaptation&lt;br&gt;ΔW_ℱ ← LoRA-Adapt(ℳ_wm, ℱ)  ;  ℳ* ← ℳ_wm ⊕ ΔW_ℱ" style="rounded=2;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#111111;strokeWidth=1.2;fontSize=7.5;align=center;" vertex="1" parent="1">
          <mxGeometry x="28" y="218" width="404" height="52" as="geometry" />
        </mxCell>

        <!-- Layer 3: WIA+ -->
        <mxCell id="l3" value="&lt;b&gt;L3 · WIA+ — Weight-Space Gradient Embedding&lt;/b&gt;&lt;br&gt;σ ← WatermarkSign(𝒦, ∇_θ ℒ)  (steganographic signature in gradient dir.)&lt;br&gt;ℳ* ← ℳ* + ε·σ  where ε ≪ 1  (imperceptible perturbation)" style="rounded=2;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#111111;strokeWidth=1.2;fontSize=7.5;align=center;" vertex="1" parent="1">
          <mxGeometry x="28" y="290" width="404" height="52" as="geometry" />
        </mxCell>

        <!-- Protected Model M* -->
        <mxCell id="pm" value="Protected Fine-Tuned LLM  ℳ*" style="ellipse;whiteSpace=wrap;html=1;fillColor=#222222;strokeColor=#111111;strokeWidth=1.5;fontColor=#ffffff;fontStyle=1;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="145" y="364" width="170" height="44" as="geometry" />
        </mxCell>

