        <!-- Input: Base LLM -->
        <mxCell id="in_llm" value="Base LLM&#xa;(pre-trained)" style="rounded=3;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#555555;strokeWidth=1;fontSize=8;" vertex="1" parent="1">
          <mxGeometry x="28" y="86" width="120" height="36" as="geometry" />
        </mxCell>

        <!-- Input: Dataset -->
        <mxCell id="in_data" value="Fine-Tune Dataset 𝒟" style="rounded=3;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#555555;strokeWidth=1;fontSize=8;" vertex="1" parent="1">
          <mxGeometry x="170" y="86" width="120" height="36" as="geometry" />
        </mxCell>

        <!-- Input: Secret Key -->
        <mxCell id="in_key" value="Secret Key 𝒦&#xa;+ Fingerprints ℱ" style="rounded=3;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#555555;strokeWidth=1;fontSize=8;" vertex="1" parent="1">
          <mxGeometry x="312" y="86" width="120" height="36" as="geometry" />
