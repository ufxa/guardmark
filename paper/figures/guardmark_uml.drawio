  <diagram id="guardmark-uml-bw-v2" name="GuardMark UML Activity Diagram">
    <mxGraphModel dx="1200" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="500" pageHeight="1200" math="1" shadow="0" background="#ffffff">
