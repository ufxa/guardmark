          <mxGeometry x="20" y="872" width="420" height="14" as="geometry" />
        </mxCell>

        <!-- Robustness -->
        <mxCell id="robust" value="&lt;b&gt;Ablation / Robustness Probe&lt;/b&gt;&lt;br&gt;R ← RobustnessProbe(M̂, 𝒦)   →   robustness score R ∈ [0, 1]" style="rounded=2;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1.1;fontSize=7.5;align=center;" vertex="1" parent="1">
          <mxGeometry x="28" y="888" width="404" height="44" as="geometry" />
        </mxCell>

        <!-- WRI Box -->
        <mxCell id="wri" value="&lt;font style=&quot;font-size: 11px;&quot;&gt;&lt;b&gt;WRI  =  α · p_d  +  β · (1 − p_f)  +  γ_w · R&lt;/b&gt;&lt;/font&gt;&lt;hr/&gt;α = 0.50 (detection rate)  ·  β = 0.30 (specificity)  ·  γ_w = 0.20 (robustness)&lt;br&gt;α + β + γ_w = 1  ;  p_d, p_f, R ∈ [0,1]  ;  WRI ∈ [0, 1]" style="rounded=2;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#111111;strokeWidth=1.8;fontSize=8;align=center;" vertex="1" parent="1">
          <mxGeometry x="28" y="952" width="404" height="60" as="geometry" />
