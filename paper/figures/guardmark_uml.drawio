        <!-- ═══════════ PHASE 3 ═══════════ -->
        <mxCell id="p3_bg" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f9f9f9;strokeColor=#111111;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="20" y="648" width="420" height="468" as="geometry" />
        </mxCell>
        <mxCell id="p3_header" value="PHASE 3 — VERIFICATION  (OCA — Ownership Claim Agent)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#111111;strokeColor=#111111;fontColor=#ffffff;fontStyle=1;fontSize=10;letterSpacing=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="648" width="420" height="26" as="geometry" />
        </mxCell>
        <mxCell id="key_verify_note" value="𝒦 + ℱ  (owner provides to verifier)" style="text;html=1;strokeColor=#888888;fillColor=#eeeeee;align=center;fontSize=7;fontStyle=2;rounded=2;" vertex="1" parent="1">
          <mxGeometry x="28" y="676" width="404" height="18" as="geometry" />
        </mxCell>

        <!-- Step 1 label + WIA Test -->
        <mxCell id="lbl_s1" value="step 1 · statistical detection" style="text;html=1;strokeColor=none;fillColor=none;align=right;fontSize=7;fontStyle=2;fontColor=#888888;" vertex="1" parent="1">
          <mxGeometry x="300" y="696" width="140" height="14" as="geometry" />
        </mxCell>
        <mxCell id="wia_test" value="&lt;b&gt;WIA Detection — z-score hypothesis test&lt;/b&gt;&lt;br&gt;Generate T tokens from M̂  →  count green-list tokens |𝒢|&lt;br&gt;z = (|𝒢| − T·γ) / √(T·γ·(1−γ))   →   p_d ← 𝟏[z &gt; z_α]" style="rounded=2;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1.1;fontSize=7.5;align=center;" vertex="1" parent="1">
          <mxGeometry x="28" y="712" width="404" height="54" as="geometry" />
        </mxCell>

        <!-- Step 2 label + FVA Test -->
        <mxCell id="lbl_s2" value="step 2 · behavioral detection" style="text;html=1;strokeColor=none;fillColor=none;align=right;fontSize=7;fontStyle=2;fontColor=#888888;" vertex="1" parent="1">
          <mxGeometry x="300" y="768" width="140" height="14" as="geometry" />
        </mxCell>
        <mxCell id="fva_test" value="&lt;b&gt;FVA Detection — cosine similarity&lt;/b&gt;&lt;br&gt;Probe M̂ with triggers {p_i}  →  responses {r̂_i}&lt;br&gt;sim_i = cos(r̂_i, r_i)   →   p_f ← |{i : sim_i ≥ τ}| / N_f" style="rounded=2;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1.1;fontSize=7.5;align=center;" vertex="1" parent="1">
          <mxGeometry x="28" y="784" width="404" height="54" as="geometry" />
        </mxCell>

        <!-- Step 3 label + Robustness -->
        <mxCell id="lbl_s3" value="step 3 · robustness probe" style="text;html=1;strokeColor=none;fillColor=none;align=right;fontSize=7;fontStyle=2;fontColor=#888888;" vertex="1" parent="1">
          <mxGeometry x="300" y="840" width="140" height="14" as="geometry" />
        </mxCell>
        <mxCell id="robust" value="&lt;b&gt;Ablation / Robustness Probe&lt;/b&gt;&lt;br&gt;R ← RobustnessProbe(M̂, 𝒦)   →   robustness score R ∈ [0, 1]" style="rounded=2;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1.1;fontSize=7.5;align=center;" vertex="1" parent="1">
          <mxGeometry x="28" y="856" width="404" height="44" as="geometry" />
        </mxCell>

        <!-- WRI Box -->
        <mxCell id="wri" value="&lt;font style=&quot;font-size: 11px;&quot;&gt;&lt;b&gt;WRI  =  α · p_d  +  β · (1 − p_f)  +  γ_w · R&lt;/b&gt;&lt;/font&gt;&lt;hr/&gt;α = 0.50 (detection rate)  ·  β = 0.30 (specificity)  ·  γ_w = 0.20 (robustness)&lt;br&gt;α + β + γ_w = 1  ;  p_d, p_f, R ∈ [0,1]  ;  WRI ∈ [0, 1]" style="rounded=2;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#111111;strokeWidth=1.8;fontSize=8;align=center;" vertex="1" parent="1">
          <mxGeometry x="28" y="920" width="404" height="60" as="geometry" />
        </mxCell>

        <!-- Decision Diamond -->
        <mxCell id="decision" value="WRI ≥ τ ?&#xa;τ = 0.70" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#111111;strokeWidth=1.8;fontSize=9;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="170" y="1000" width="120" height="70" as="geometry" />
        </mxCell>

        <!-- Ownership Confirmed -->
        <mxCell id="confirmed" value="Ownership&#xa;Confirmed" style="rounded=3;whiteSpace=wrap;html=1;fillColor=#222222;strokeColor=#111111;strokeWidth=1.3;fontColor=#ffffff;fontStyle=1;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="28" y="1034" width="128" height="46" as="geometry" />
