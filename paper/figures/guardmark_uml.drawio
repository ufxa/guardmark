        <mxCell id="p2_header" value="PHASE 2 — DEPLOYMENT  /  ATTACK  (optional)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#555555;strokeColor=#555555;fontColor=#ffffff;fontStyle=1;fontSize=10;letterSpacing=1;" vertex="1" parent="1">
