        <!-- WIA Test -->
        <mxCell id="wia_test" value="&lt;b&gt;WIA Detection — z-score hypothesis test&lt;/b&gt;&lt;br&gt;Generate T tokens from M̂  →  count green-list tokens |𝒢|&lt;br&gt;z = (|𝒢| − T·γ) / √(T·γ·(1−γ))   →   p_d ← 𝟏[z &gt; z_α]" style="rounded=2;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1.1;fontSize=7.5;align=center;" vertex="1" parent="1">
          <mxGeometry x="28" y="744" width="404" height="54" as="geometry" />
        </mxCell>

