        <mxCell id="a_suspect_wia" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#111111;strokeWidth=1.3;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="suspect" target="wia_test" parent="1">
